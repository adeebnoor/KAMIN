{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamin-12mf.onrender.com/mapping/course-skill-map.schema.json",
  "title": "Kamin University Evidence Adapter mapping",
  "type": "object",
  "required": [
    "version",
    "namespace",
    "status",
    "mappings"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "department-reviewed",
        "governed-pilot-mapping",
        "institution-verified"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "evidenceType",
          "skills",
          "learningOutcome"
        ],
        "properties": {
          "evidenceType": {
            "enum": [
              "knowledge",
              "applied",
              "assessment",
              "credential"
            ]
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "learningOutcome": {
            "type": "object",
            "required": [
              "ar",
              "en"
            ],
            "properties": {
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
