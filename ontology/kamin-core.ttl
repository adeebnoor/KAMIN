@prefix kamin: <urn:kamin:> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ceterms: <https://purl.org/ctdl/terms/> .
@prefix ceasn: <https://purl.org/ctdlasn/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

kamin:ontology
  a owl:Ontology ;
  rdfs:label "Kamin Person 360 thin ontology"@en ;
  rdfs:label "أنطولوجيا كامن الرشيقة لنموذج الفرد 360"@ar ;
  owl:versionInfo "0.1.0" .

kamin:Claim a owl:Class ; rdfs:subClassOf prov:Entity .
kamin:Observation a owl:Class ; rdfs:subClassOf prov:Entity .
kamin:Goal a owl:Class ; rdfs:subClassOf skos:Concept .
kamin:Constraint a owl:Class ; rdfs:subClassOf skos:Concept .
kamin:FitAssessment a owl:Class ; rdfs:subClassOf prov:Entity .
kamin:FitMechanism a owl:Class ; rdfs:subClassOf prov:Entity .
kamin:Outcome a owl:Class ; rdfs:subClassOf prov:Entity .

kamin:subject a owl:ObjectProperty ; rdfs:domain kamin:Claim .
kamin:predicate a owl:DatatypeProperty ; rdfs:domain kamin:Claim .
kamin:object a owl:ObjectProperty ; rdfs:domain kamin:Claim .
kamin:value a owl:DatatypeProperty ; rdfs:domain kamin:Claim .
kamin:instrument a owl:DatatypeProperty ; rdfs:domain kamin:Observation .
kamin:instrumentVersion a owl:DatatypeProperty ; rdfs:domain kamin:Observation .
kamin:consentPurpose a owl:ObjectProperty ; rdfs:domain prov:Entity .
kamin:evidenceStrength a owl:DatatypeProperty ; rdfs:domain prov:Entity .
kamin:fitTarget a owl:ObjectProperty ; rdfs:domain kamin:FitAssessment .
kamin:mechanism a owl:ObjectProperty ; rdfs:domain kamin:FitAssessment ; rdfs:range kamin:FitMechanism .

# External domain concepts remain in their source ontologies/vocabularies:
# schema:Person, schema:Course, schema:Occupation
# ceterms:Credential, ceasn:Competency, skos:Concept, prov:Entity.
